(defconst organice-brainstorm-triggers
  '(
    ("Recursos" "¿Quién puede aportar? ¿Se ha hecho antes? ¿Qué errores y éxitos hay de los que aprender? ¿Qué recursos tengo y cuáles necesito?")
    ("Asuntos ejecutivos" "¿Cómo encaja con el plan estratégico y con otras prioridades? ¿Qué efecto tiene en la posición competitiva?")
    ("Administración" "¿Quién responde del éxito? Comunicación, estructuras, personal, subcontratas, habilidades, formación, quién tiene que saber qué, políticas afectadas, moral, diversión.")
    ("Finanzas" "¿Cuánto cuesta? ¿De dónde sale el dinero? ¿Qué retorno tiene? ¿Quién lo autoriza?")
    ("Operaciones" "¿Plazos? ¿Fechas inamovibles? ¿Quién hace el trabajo? ¿Cómo se entrega completo?")
    ("Calidad" "¿Cómo se vigila el progreso? ¿Qué datos e informes hacen falta?")
    ("Política" "¿El apoyo de quién hace falta?")
    ("Partes interesadas" "Consejo, accionistas, empleados, proveedores, clientes, comunidad: ¿qué necesita cada uno?")
    ("Legal" "¿Qué asuntos legales o normativa afectan?")
    ("Espacio, instalaciones y equipos" "¿Qué sitio, instalaciones o equipos hacen falta?")
    ("Investigación" "¿Qué podría necesitar saber?")
    ("Relaciones públicas" "¿Qué hay que comunicar fuera, y a quién?")
    ("Riesgos" "¿Qué podría pasar? ¿Podría manejarlo?")
    ("Pensamiento creativo" "¿A quién le importaría el éxito? ¿Qué diría o aportaría que aún no he considerado? La peor idea imaginable y su contraria. Lo más descabellado. ¿Qué lo haría único? ¿Qué no me he preguntado aún?"))
  "Lista de disparadores del proyecto (lluvia de ideas): (NOMBRE PREGUNTAS).")

(defconst organice-plan-steps
  '(
    (purpose "Propósito y principios" "¿Por qué lo haces? Y los principios: las normas y estándares con que decidirás (p. ej. «sin pasarse del presupuesto», «que todos estén de acuerdo»).")
    (outcome "Resultado deseado" "¿Cómo sería con éxito total? ¿Cómo sabrás que está terminado? Imagínalo hecho.")
    (ideas "Lluvia de ideas" "Todo lo que se te ocurra, sin juzgar ni ordenar: la realidad actual, lo que no sabes, lo que aún no has considerado. Mira el proyecto desde todos los lados (las preguntas de abajo ayudan).")
    (order "Organizar" "¿Qué tiene que pasar para que pase todo? Ordena (secuencia o prioridad), quita lo que sobre y marca como componente lo que sea una parte con varias acciones.")
    (first "Siguientes acciones" "Para cada parte que pueda avanzar ya: ¿cuál es la siguiente acción física? (y, si no la haces tú, ¿quién?). Si aún no se sabe, «hace falta planificar más».")
    (mind "¿Sigue en tu mente?" "Si el proyecto ya no te ronda la cabeza, has planificado lo suficiente. Si sigue en tu mente, falta: si falta claridad, sube (propósito, resultado); si falta movimiento, baja (acciones)."))
  "Pasos del Modelo de Planificación Natural: (ID NOMBRE PISTA).")

(defconst organice-weekly-review-steps
  '(
    (loose "Despejar" "Papeles y materiales sueltos" "Recoge papeles, notas, tarjetas, recibos y demás cosas sueltas (también en el bolso, la mesa o el móvil) y mételas en el Inbox.")
    (inbox "Despejar" "Inbox a cero" "Procesa cada cosa del Inbox hasta dejarlo vacío.")
    (mind "Despejar" "Vaciar la cabeza" "Apunta todo lo que tengas en la cabeza: proyectos, acciones, esperas, ideas. El Volcado mental te lo pregunta por categorías.")
    (next "Al día" "Revisar Next" "Tacha lo que ya está hecho. ¿Hay más pasos que apuntar?")
    (past "Al día" "Calendario pasado" "Repasa con detalle lo que tenía fecha desde la última revisión (y lo atrasado): ¿quedó alguna acción pendiente, algo que apuntar o que guardar como referencia?")
    (upcoming "Al día" "Calendario próximo" "Mira lo que viene, a corto y a largo plazo: ¿hay que preparar algo o dispara alguna acción?")
    (waiting "Al día" "Waiting" "Marca lo que ya ha llegado y apunta un seguimiento para lo que se retrasa.")
    (projects "Al día" "Proyectos, uno a uno" "Cada proyecto activo: ¿cómo va? ¿sigue teniendo sentido su resultado? Mira sus notas y material: cada uno necesita al menos una acción siguiente.")
    (goals "Al día" "Objetivos y resultados mayores" "Repasa tus objetivos y resultados mayores: ¿piden algún proyecto o acción nueva?")
    (checklists "Al día" "Checklists relevantes" "Repasa las listas de control que uses (responsabilidades, rutinas, viajes, eventos…): ¿falta hacer algo?")
    (someday "Crear" "Someday / Maybe" "Activa lo que ya toque (pásalo a su lista) y borra lo que ya no te interese.")
    (creative "Crear" "Sé creativo y valiente" "¿Alguna idea nueva, atrevida o creativa que añadir? Apúntala, por loca que parezca."))
  "Pasos de la Revisión semanal oficial: (ID FASE NOMBRE PISTA).")

(defconst organice-daily-review-steps
  '(
    (due "Calendario de hoy" "Lo programado y lo que vence hoy (y lo atrasado). Es el «paisaje fijo» del día: lo que tiene que pasar hoy.")
    (tickler "Tickler de hoy" "Recordatorios que tocan hoy (o antes). Pásalos al Inbox para procesarlos.")
    (waiting "Waiting vencidos" "Esperas cuya fecha ya ha llegado: marca lo recibido o reclámalo.")
    (next "Repaso de Next" "Echa un vistazo a todas tus acciones siguientes. Luego elige qué hacer con «¿Qué hago ahora?» (dónde estás, tiempo, energía y prioridad)."))
  "Pasos de la Revisión diaria: (ID NOMBRE PISTA).")

(defconst organice-horizon-steps
  '(
    (areas "Áreas de responsabilidad" "¿Cada área tiene algún proyecto en marcha? ¿Falta alguna?")
    (goals "Objetivos (1–2 años)" "¿Algún proyecto mueve cada objetivo? ¿Sobra o falta alguno?")
    (vision "Visión (3–5 años)" "¿Sigue siendo lo que quieres? Cámbiala si hace falta.")
    (purpose "Propósito y principios" "¿Por qué haces lo que haces? Léelo con calma."))
  "Pasos de la Revisión de horizontes (de abajo arriba): (ID NOMBRE PISTA).")

